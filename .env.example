# Copy to .env on the Docker host and fill in. .env is gitignored - keep it that way,
# it holds the Home Assistant token and the house coordinates.

# Home Assistant, reachable from inside the container.
# A hostname like homeassistant.local often will not resolve from a container;
# the host's LAN IP is the reliable choice.
HOME_ASSISTANT_BASE_URL=http://192.0.2.10:8123
HOME_ASSISTANT_TOKEN=

# Where the forecast is for. Kept server-side so it never reaches the browser.
DASHBOARD_LATITUDE=
DASHBOARD_LONGITUDE=
DASHBOARD_TIMEZONE=auto
